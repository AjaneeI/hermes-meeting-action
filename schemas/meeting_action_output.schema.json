{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AjaneeI/hermes-meeting-action/schemas/meeting_action_output.schema.json",
  "title": "Hermes Meeting Action Output",
  "description": "Structured extraction contract for converting meeting artifacts into traceable decisions, committed actions, and open questions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meeting",
    "decisions",
    "actions",
    "open_questions",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "meeting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "occurred_on"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "occurred_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/open_question"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "needs_human_review",
        "reasons"
      ],
      "properties": {
        "needs_human_review": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote",
        "speaker"
      ],
      "properties": {
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "speaker": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "evidence",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^d[0-9]+$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "details",
        "owner",
        "due",
        "evidence",
        "confidence",
        "ambiguity_flags",
        "approval_state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^a[0-9]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "status"
          ],
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "enum": [
                "explicit",
                "missing",
                "ambiguous"
              ]
            }
          }
        },
        "due": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "date_text",
            "status"
          ],
          "properties": {
            "date": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "date_text": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "enum": [
                "explicit",
                "resolved_from_relative",
                "missing",
                "ambiguous"
              ]
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ambiguity_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approval_state": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        }
      }
    },
    "open_question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "evidence",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^q[0-9]+$"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}